# ============================================================================
# Plantilla de configuracion — AAG Portal
# ============================================================================
# Los valores de este archivo son los de PRODUCCION. Para desarrollo local se
# cambian APP_ENV=local, APP_DEBUG=true y SESSION_SECURE_COOKIE=false.
#
# El motivo de que el valor seguro sea el de partida y no al reves: esta
# plantilla es lo que se copia al desplegar, y un APP_DEBUG=true olvidado en
# el servidor expone en cada error el APP_KEY, las credenciales de base de
# datos y las de correo.
# ============================================================================

APP_NAME="AAG Portal"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=America/Guayaquil

# El dominio REAL con https://. Se usa para generar enlaces absolutos (correos,
# canonicas, sitemap), asi que un valor equivocado se nota en sitios raros.
# Al publicar primero en un subdominio de pruebas, aqui va el subdominio; y se
# cambia al pasar al dominio definitivo.
APP_URL=https://www.aag.gob.ec

# ── Proxies de confianza ─────────────────────────────────────────────────────
# Vacio      : el dominio apunta directo al hosting (sin Cloudflare).
# cloudflare : Cloudflare esta en modo proxy (nube naranja en el DNS).
#
# Si se usa Cloudflare y esto queda vacio, TODOS los visitantes comparten la IP
# del proxy: el limite del boletin se vuelve global y bloquea el formulario para
# todo el mundo tras cinco intentos de cualquiera. Ver config/proxies.php.
TRUSTED_PROXIES=

# ── API publica de solo lectura ──────────────────────────────────────────────
# DESACTIVADA por defecto, y asi debe quedarse mientras nadie la consuma.
#
# Con false las rutas /api/v1/* ni siquiera se registran: responden 404, no 401.
# Un 401 le confirmaria a quien sondea el servidor que ahi hay algo detras.
#
# Para activarla: poner true y ejecutar `php artisan config:cache`. El segundo
# paso no es opcional — con la configuracion cacheada el .env ni se lee, y el
# cambio no surte efecto. Ver docs/API.md.
API_ENABLED=false
# Peticiones por token y minuto.
API_RATE_LIMIT=60

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_ES

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
# En produccion nunca "debug": el log recogeria las consultas SQL con sus
# parametros, y el archivo se acaba compartiendo al depurar una incidencia.
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# ── Sesion ──────────────────────────────────────────────────────────────────
SESSION_DRIVER=database
# 120 min es mucho para un panel administrativo; 60 es un termino razonable.
SESSION_LIFETIME=60
# Cifra el contenido de la sesion en el almacen.
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
# CRITICO en produccion: sin esto la cookie de sesion viaja tambien por HTTP
# plano, y basta una peticion sin cifrar para capturar la sesion de un
# administrador. Ponlo en false SOLO en local, donde no hay HTTPS.
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
# "strict" evita que la cookie se envie en navegaciones desde otros sitios.
SESSION_SAME_SITE=strict

# ── Semilla inicial ─────────────────────────────────────────────────────────
# Si se define, el seeder la usa como contrasena de las cuentas que cree; si
# no, genera una aleatoria y la imprime una sola vez por consola.
# Dejala VACIA en produccion y cambia la contrasena tras el primer acceso.
SEED_ADMIN_PASSWORD=

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ── Correo saliente ──────────────────────────────────────────────────────────
# OJO: con MAIL_MAILER=log los correos NO se envian, se escriben en el log y
# nadie se entera. Sirve para desarrollo; en produccion deja los formularios de
# contacto sin avisar a nadie, y el fallo es silencioso.
#
# Datos de la cuenta de correo del cPanel (Cuentas de correo > Conectar
# dispositivos). La contrasena se escribe DIRECTAMENTE en el servidor.
#
# No se usa 'sendmail': ese transporte arrastra un aviso de seguridad
# (CVE-2026-45068) que SMTP no tiene.
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=mail.TU-DOMINIO
MAIL_PORT=465
MAIL_USERNAME=no-responder@TU-DOMINIO
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="no-responder@TU-DOMINIO"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
