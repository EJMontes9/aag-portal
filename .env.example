# ============================================================================
# Plantilla de configuracion — AAG Portal
# ============================================================================
# Los valores de este archivo son los de PRODUCCION. Para desarrollo local se
# cambian APP_ENV=local, APP_DEBUG=true y SESSION_SECURE_COOKIE=false.
#
# El motivo de que el valor seguro sea el de partida y no al reves: esta
# plantilla es lo que se copia al desplegar, y un APP_DEBUG=true olvidado en
# el servidor expone en cada error el APP_KEY, las credenciales de base de
# datos y las de correo.
# ============================================================================

APP_NAME="AAG Portal"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=America/Guayaquil
APP_URL=https://www.aag.gob.ec

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_ES

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
# En produccion nunca "debug": el log recogeria las consultas SQL con sus
# parametros, y el archivo se acaba compartiendo al depurar una incidencia.
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# ── Sesion ──────────────────────────────────────────────────────────────────
SESSION_DRIVER=database
# 120 min es mucho para un panel administrativo; 60 es un termino razonable.
SESSION_LIFETIME=60
# Cifra el contenido de la sesion en el almacen.
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
# CRITICO en produccion: sin esto la cookie de sesion viaja tambien por HTTP
# plano, y basta una peticion sin cifrar para capturar la sesion de un
# administrador. Ponlo en false SOLO en local, donde no hay HTTPS.
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
# "strict" evita que la cookie se envie en navegaciones desde otros sitios.
SESSION_SAME_SITE=strict

# ── Semilla inicial ─────────────────────────────────────────────────────────
# Si se define, el seeder la usa como contrasena de las cuentas que cree; si
# no, genera una aleatoria y la imprime una sola vez por consola.
# Dejala VACIA en produccion y cambia la contrasena tras el primer acceso.
SEED_ADMIN_PASSWORD=

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
